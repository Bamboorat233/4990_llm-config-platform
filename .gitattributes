# Normalise line endings to avoid meaningless diffs between Windows / macOS / Linux
* text=auto

*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf

# Binary
*.pdf   binary
*.docx  binary
*.doc   binary
*.png   binary
*.jpg   binary
*.safetensors binary
