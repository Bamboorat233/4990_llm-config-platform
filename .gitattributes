# 统一换行符,避免 Windows / macOS / Linux 之间产生无意义的 diff
* text=auto

*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf

# 二进制
*.pdf   binary
*.docx  binary
*.doc   binary
*.png   binary
*.jpg   binary
*.safetensors binary
